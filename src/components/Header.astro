---
import studio from '@/data/services.json';
---

<header class="header">
  <div class="header__container">
    <a href="/" class="header__logo">
      <img src="/images/noemi-watermark.png" alt="Noemi Parrales Beauty Studio" class="header__logo-img" width="132" height="84" />
    </a>

    <nav class="header__nav">
      <a href="/#acerca">Mi Perfil</a>
      <a href="/#servicios">Servicios</a>
      <a href="/#galeria">Galería</a>
      <a href="/#contacto">Contacto</a>
    </nav>


  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #ede4ed;
  }

  .header__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header__logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .header__logo-img {
    height: 84px;
    width: auto;
    display: block;
  }

  .header__nav {
    display: flex;
    gap: 1.5rem;
  }

  .header__nav a {
    color: #9e7a9e;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .header__nav a:hover {
    color: #3d2b3d;
  }



  @media (max-width: 640px) {
    .header__nav {
      display: none;
    }
  }
</style>
