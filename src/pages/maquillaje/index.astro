---

<ServiceLayout category={category} hideContact={true}>
  <section class="maquillaje-gallery" slot="gallery">
    <div class="maquillaje-gallery__container">
      <h2>Nuestros Trabajos de Maquillaje</h2>
      <div class="maquillaje-gallery__grid">
        {images.map((img) => (
          <div class="maquillaje-gallery__item">
            <img src={img.src} alt={img.alt} loading="lazy" width="400" height="400" />
            <span class="maquillaje-gallery__label">{img.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</ServiceLayout>

<style>
  .maquillaje-gallery {
    padding: 4rem 1.5rem;
    background: white;
  }

  .maquillaje-gallery__container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .maquillaje-gallery h2 {
    text-align: center;
    font-size: 1.5rem;
    font-weight: 400;
    color: #3d2b3d;
    margin: 0 0 2rem;
  }

  .maquillaje-gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .maquillaje-gallery__item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(61, 43, 61, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .maquillaje-gallery__item img {
    width: 100%;
    height: auto;
    display: block;
  }

  .maquillaje-gallery__label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(61, 43, 61, 0.85));
    color: white;
    padding: 2rem 1rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
  }
</style>
